generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  credits       Int            @default(100) // Moved from User to Tenant
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  generations   Generation[]
  songs         Song[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  events        ProductEvent[]
  feedback      BetaFeedback[]
}

model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  generations   Generation[]
  events        ProductEvent[]
  feedback      BetaFeedback[]
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("owner") // owner, admin, member
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Generation {
  id              String           @id @default(cuid())
  tenantId        String
  userId          String
  prompt          String
  status          GenerationStatus @default(QUEUED)
  provider        String           @default("mock")
  model           String?
  audioStorageKey String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  song            Song?
  events          ProductEvent[]
  feedback        BetaFeedback[]

  @@index([tenantId, createdAt])
  @@index([status])
}

model Song {
  id           String     @id @default(cuid())
  tenantId     String
  generationId String     @unique
  title        String
  lyrics       String?
  bpm          Int?
  musicalKey   String?
  durationSec  Int?
  createdAt    DateTime   @default(now())
  
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  assets       Asset[]

  @@index([tenantId, createdAt])
}

model Asset {
  id         String   @id @default(cuid())
  tenantId   String
  songId     String
  kind       String   // audio_master, audio_stem, cover_art
  storageUrl String
  bytes      Int
  
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Subscription {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  stripeCustomerId     String
  stripeSubscriptionId String?
  plan                 String   @default("free")
  status               String   @default("active")
  
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String   // generation_count, storage_bytes
  quantity   Int
  recordedAt DateTime @default(now())
  
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, metric, recordedAt])
}

model ProductEvent {
  id           String      @id @default(cuid())
  tenantId     String
  userId       String
  event        String
  generationId String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([tenantId, event])
  @@index([userId])
}

model BetaFeedback {
  id                   String      @id @default(cuid())
  tenantId             String
  userId               String
  generationId         String?
  type                 String
  rating               Int?
  musicQualityRating   Int?
  promptAccuracyRating Int?
  easeOfUseRating      Int?
  wouldUseAgain        Boolean?
  message              String?
  createdAt            DateTime    @default(now())
  
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation           Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}